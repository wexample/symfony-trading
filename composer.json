{
  "name": "wexample/symfony-trading",
  "description": "Trading for Symfony: candles, trade markers and time series as entities, served by list endpoints",
  "version": "3.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTrading\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTrading\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-api": ">=24.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "symfony/uid": ">=6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}